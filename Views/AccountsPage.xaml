<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lab7.Models"
             x:Class="Lab7.Views.AccountsPage"
             Title="Особові рахунки"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="15">

        <VerticalStackLayout Grid.Row="0">
            <Label Text="📄 Особові рахунки" FontSize="26" FontAttributes="Bold" TextColor="White" />
            <Label Text="Керування рахунками, адресами та прив'язкою до мешканців" FontSize="14" TextColor="#94A3B8" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Stroke="#334155" StrokeThickness="1" BackgroundColor="#1E293B" Padding="15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Label x:Name="FormTitleLabel" Text="Створити новий особовий рахунок" FontSize="16" FontAttributes="Bold" TextColor="#38BDF8" />

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="№ Рахунку *" FontSize="12" TextColor="#94A3B8" />
                        <Entry x:Name="AccountNumberEntry" Keyboard="Numeric" Placeholder="1001" TextColor="White" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Власник (Мешканець) *" FontSize="12" TextColor="#94A3B8" />
                        <Picker x:Name="TenantPicker" ItemDisplayBinding="{Binding FullName}" TextColor="White" BackgroundColor="#0F172A" Title="Оберіть власника" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Місто *" FontSize="12" TextColor="#94A3B8" />
                        <Picker x:Name="CityPicker" ItemDisplayBinding="{Binding Name}" TextColor="White" BackgroundColor="#0F172A" Title="Оберіть місто" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="2*, *, *, *, *" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Вулиця" FontSize="12" TextColor="#94A3B8" />
                        <Entry x:Name="StreetEntry" Placeholder="Хрещатик" TextColor="White" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Буд." FontSize="12" TextColor="#94A3B8" />
                        <Entry x:Name="HouseEntry" Placeholder="10" TextColor="White" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Кв." FontSize="12" TextColor="#94A3B8" />
                        <Entry x:Name="AptEntry" Placeholder="25" TextColor="White" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="3">
                        <Label Text="Площа (м²)" FontSize="12" TextColor="#94A3B8" />
                        <Entry x:Name="AreaEntry" Keyboard="Numeric" Placeholder="54.5" TextColor="White" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="4">
                        <Label Text="Мешканців" FontSize="12" TextColor="#94A3B8" />
                        <Entry x:Name="ResidentsEntry" Keyboard="Numeric" Placeholder="2" TextColor="White" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>
                </Grid>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="End" Margin="0,5,0,0">
                    <Button x:Name="CancelBtn" Text="Скасувати" Clicked="OnCancelClicked" BackgroundColor="#475569" TextColor="White" IsVisible="False" />
                    <Button x:Name="SaveBtn" Text="💾 Зберегти зміни" Clicked="OnSaveClicked" BackgroundColor="#0284C7" TextColor="White" IsVisible="False" />
                    <Button x:Name="AddBtn" Text="➕ Створити рахунок" Clicked="OnAddClicked" BackgroundColor="#059669" TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2" x:Name="AccountsCollectionView" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Рахунків не знайдено або база порожня" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center" Margin="20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Account">
                    <Border Stroke="#1E293B" BackgroundColor="#1E293B" StrokeThickness="1" Margin="0,0,0,10" Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" ColumnSpacing="15" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="№ РАХУНКУ" FontSize="10" TextColor="#94A3B8" />
                                <Label Text="{Binding AccountNumber}" FontSize="18" FontAttributes="Bold" TextColor="#38BDF8" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding Tenant.FullName, TargetNullValue='(Власник не вказаний)'}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                <Label FontSize="12" TextColor="#94A3B8">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding City.Name, TargetNullValue='Невідоме місто'}" />
                                            <Span Text=", вул. " />
                                            <Span Text="{Binding Street}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding House}" />
                                            <Span Text=", кв. " />
                                            <Span Text="{Binding Apt}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                <Label Text="Площа" FontSize="11" TextColor="#94A3B8" />
                                <Label Text="{Binding Area, StringFormat='{0} м²'}" FontSize="14" FontAttributes="Bold" TextColor="#E2E8F0" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="3" HorizontalOptions="End">
                                <Label Text="Осіб" FontSize="11" TextColor="#94A3B8" />
                                <Label Text="{Binding Residents, StringFormat='{0} чол.'}" FontSize="14" FontAttributes="Bold" TextColor="#FBBF24" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="4" Spacing="5">
                                <Button Text="✏️" Clicked="OnEditItemClicked" CommandParameter="{Binding .}" BackgroundColor="#334155" TextColor="White" HeightRequest="38" WidthRequest="44" Padding="0" />
                                <Button Text="🗑️" Clicked="OnDeleteItemClicked" CommandParameter="{Binding .}" BackgroundColor="#DC2626" TextColor="White" HeightRequest="38" WidthRequest="44" Padding="0" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
