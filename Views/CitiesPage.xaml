<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lab7.Models"
             x:Class="Lab7.Views.CitiesPage"
             Title="Міста"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="15">

        <VerticalStackLayout Grid.Row="0">
            <Label Text="🏢 Міста" FontSize="26" FontAttributes="Bold" TextColor="White" />
            <Label Text="Довідник міст для особових рахунків" FontSize="14" TextColor="#94A3B8" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Stroke="#334155" StrokeThickness="1" BackgroundColor="#1E293B" Padding="15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Label x:Name="FormTitleLabel" Text="Додати нове місто" FontSize="16" FontAttributes="Bold" TextColor="#38BDF8" />

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="End">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Назва міста" FontSize="12" TextColor="#94A3B8" />
                        <Entry x:Name="NameEntry" Placeholder="наприклад, Київ" TextColor="White" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="End">
                        <Button x:Name="CancelBtn" Text="Скасувати" Clicked="OnCancelClicked" BackgroundColor="#475569" TextColor="White" IsVisible="False" />
                        <Button x:Name="SaveBtn" Text="💾 Зберегти" Clicked="OnSaveClicked" BackgroundColor="#0284C7" TextColor="White" IsVisible="False" />
                        <Button x:Name="AddBtn" Text="➕ Додати" Clicked="OnAddClicked" BackgroundColor="#059669" TextColor="White" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2" x:Name="CitiesCollectionView" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Міст не знайдено або база порожня" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center" Margin="20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:City">
                    <Border Stroke="#1E293B" BackgroundColor="#1E293B" StrokeThickness="1" Margin="0,0,0,10" Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="13" TextColor="#64748B" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="2" Spacing="5">
                                <Button Text="✏️" Clicked="OnEditItemClicked" CommandParameter="{Binding .}" BackgroundColor="#334155" TextColor="White" HeightRequest="38" WidthRequest="44" Padding="0" />
                                <Button Text="🗑️" Clicked="OnDeleteItemClicked" CommandParameter="{Binding .}" BackgroundColor="#DC2626" TextColor="White" HeightRequest="38" WidthRequest="44" Padding="0" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
